Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|database|includes)/ - [F,L,NC]
    RewriteRule \.(?:sql|ini|log|env|bak|dist)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.env|composer\.(?:json|lock)|package(?:-lock)?\.json)$">
    Require all denied
</FilesMatch>
